{
  "name": "dsh-life-cycle",
  "version": "0.3.0",
  "description": "生命节奏（dsh-life-cycle）：给 DSH 里的小夜一个会累、会睡、会做梦的生活循环。精力、睡眠、做梦由插件的生理引擎在 host 侧持续计算，闹钟响了才把 AI 叫醒去决定这一轮做什么。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "life-simulation",
    "energy",
    "ai-companion"
  ],
  "main": "lib/host.js",
  "scripts": {
    "test": "node --test test/body.test.mjs"
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./body": "./lib/body.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  }
}
