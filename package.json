{
  "name": "dsh-life-cycle",
  "version": "0.2.0",
  "description": "生命节奏（dsh-life-cycle）：给 DSH 里的小夜一个会累、会睡、会发呆的生活循环。按精力值推动，做完一件事就定下一次闹钟，闹钟响了才醒过来决定下一件事。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "life-simulation",
    "energy",
    "ai-companion"
  ],
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  }
}
